#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"
# Git exports repository variables such as GIT_DIR to hooks. Tests that create
# fixture repositories must not inherit them, or their git commands would
# reconfigure this checkout (for example setting core.bare or user.name).
for name in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do
  unset "$name"
done
exec node scripts/pre-push.mjs
