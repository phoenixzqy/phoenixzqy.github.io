{
  "name": "qiyu-zhao-resume",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Qiyu Zhao's static, accessible, AI-inspired resume.",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "start": "python3 -m http.server 4173 --bind 127.0.0.1",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "validate:apps": "node scripts/validate-apps.mjs",
    "test:unit": "node --test tests/*.test.js",
    "test": "npm run validate:apps && npm run test:unit && playwright test",
    "test:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.58.2",
    "pdfjs-dist": "^6.3.289"
  }
}
