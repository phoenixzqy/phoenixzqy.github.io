    # --- Install ----------------------------------------------------------
    # zai ships a Python package installer at the root of the archive. It
    # performs the real installation (executable, agent homes, PATH) and reports
    # its result. The entry point is exactly 'install.py' beside its
    # '_installer.py' library; the archive carries other .py files that must
    # never be run instead.
    $packageInstaller = Join-Path $extract 'install.py'
    if (-not (Test-Path -LiteralPath $packageInstaller -PathType Leaf)) {
        Stop-Install "the package did not contain 'install.py' at its root. Nothing was installed."
    }

    $forwarded = @()
    if (Get-ZaiEnv 'ZAI_INSTALL_DIR') { $forwarded += @('--install-dir', $installDir) }
    $extraArgs = Get-ZaiEnv 'ZAI_INSTALL_ARGS'
    if ($extraArgs) { $forwarded += @($extraArgs -split '\s+' | Where-Object { $_ }) }

    Write-Host "Running the bundled package installer with $python..."
    & $python @pythonArgs $packageInstaller @forwarded
    if ($LASTEXITCODE -ne 0) {
        Stop-Install "the bundled package installer exited with code $LASTEXITCODE." $LASTEXITCODE
    }

    Write-Host ''
    foreach ($app in @('zai', 'zai-editor', 'zai-gitter')) {
        if (Test-Path -LiteralPath (Join-Path $installDir "$app.exe") -PathType Leaf) {
            Write-Host "Installed command: $app"
        }
    }
    Install-Shortcut $installDir 'ze' 'zai-editor'
    Install-Shortcut $installDir 'zg' 'zai-gitter'
    Show-Activation $installDir '@EXECUTABLE@'
    Write-Host "Documentation: $site/apps/docs/?id=$appId"
