#Requires -Version 5.1
<#
    One-line installer for @DISPLAY_NAME@ (@APP_ID@).

        irm https://phoenixzqy.github.io/install/@APP_ID@.ps1 | iex

    Generated by scripts/build-installers.mjs from
    install/templates/installer.ps1.in. Edit the template, not this file, and
    re-run `npm run build:installers`.

    Environment overrides:
      ZAI_INSTALL_DIR           Installation directory (default: %USERPROFILE%\.zai).
      ZAI_RELEASE_MANIFEST_URL  Release manifest URL (used by the test suite).
      ZAI_INSTALL_ARGS          Extra arguments, because `irm | iex` passes none.
#>

Set-StrictMode -Version 1.0
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

$appId = '@APP_ID@'
$executable = '@EXECUTABLE@.exe'
$displayName = '@DISPLAY_NAME@'
$site = 'https://phoenixzqy.github.io'

function Get-ZaiEnv([string] $name) {
    $value = [Environment]::GetEnvironmentVariable($name)
    if ([string]::IsNullOrWhiteSpace($value)) { return $null }
    return $value
}

function Stop-Install([string] $message, [int] $code = 1) {
    [Console]::Error.WriteLine("$displayName installer: $message")
    exit $code
}

$manifestUrl = Get-ZaiEnv 'ZAI_RELEASE_MANIFEST_URL'
if (-not $manifestUrl) { $manifestUrl = "$site/releases/$appId/latest/manifest.json" }
$installDir = Get-ZaiEnv 'ZAI_INSTALL_DIR'
if (-not $installDir) { $installDir = Join-Path $env:USERPROFILE '.zai' }

# Windows PowerShell 5.1 may still default to TLS 1.0; PowerShell 7 ignores this.
try {
    [Net.ServicePointManager]::SecurityProtocol =
        [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
} catch {
    Write-Verbose 'The TLS 1.2 protocol could not be selected explicitly.'
}

function Get-Architecture {
    try {
        switch ([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString()) {
            'X64' { return 'x64' }
            'Arm64' { return 'arm64' }
        }
    } catch {
        Write-Verbose 'RuntimeInformation is unavailable; falling back to the environment.'
    }
    $raw = $env:PROCESSOR_ARCHITEW6432
    if ([string]::IsNullOrWhiteSpace($raw)) { $raw = $env:PROCESSOR_ARCHITECTURE }
    switch ($raw) {
        'AMD64' { return 'x64' }
        'ARM64' { return 'arm64' }
    }
    Stop-Install "unsupported processor architecture: $raw. Published builds cover x64 and arm64."
}

function Save-Download([string] $url, [string] $destination) {
    for ($hop = 0; $hop -le 5; $hop++) {
        $uri = $null
        if (-not [Uri]::TryCreate($url, [UriKind]::Absolute, [ref] $uri)) {
            Stop-Install "invalid download URL: $url"
        }
        $localFixture = $hop -eq 0 -and (Get-ZaiEnv 'ZAI_RELEASE_MANIFEST_URL') -and
            $url -cmatch '^http://127\.0\.0\.1(?::[0-9]+)?(?:/|[?#]|$)' -and
            $uri.Host -ceq '127.0.0.1'
        if ($uri.Scheme -ne 'https' -and -not $localFixture) {
            Stop-Install "refusing to download over a non-HTTPS URL: $url"
        }
        try {
            $response = Invoke-WebRequest -Uri $uri -OutFile $destination -UseBasicParsing -MaximumRedirection 0 -PassThru
            $status = [int] $response.StatusCode
            if ($status -lt 300 -or $status -ge 400) { return }
        } catch {
            $response = $_.Exception.Response
            if ($null -eq $response) {
                Stop-Install "download failed: $url ($($_.Exception.Message))"
            }
            $status = [int] $response.StatusCode
            if ($status -lt 300 -or $status -ge 400) {
                Stop-Install "download failed: $url ($($_.Exception.Message))"
            }
        }
        if ($localFixture) { Stop-Install "refusing to follow a plaintext redirect: $url" }
        if ($response -is [System.Net.Http.HttpResponseMessage]) {
            $location = [string] $response.Headers.Location
        } else {
            $location = [string] $response.Headers['Location']
        }
        if (-not $location) { Stop-Install "redirect without a Location: $url" }
        $url = [Uri]::new($uri, $location).AbsoluteUri
    }
    Stop-Install "too many download redirects: $url"
}

function Add-UserPath([string] $directory) {
    # The user PATH is read and written through the registry rather than
    # [Environment]::GetEnvironmentVariable/SetEnvironmentVariable: those expand
    # %VARIABLE% references on read and always write a plain string, which would
    # permanently freeze entries such as %USERPROFILE%\bin to today's value and
    # downgrade REG_EXPAND_SZ to REG_SZ.
    $key = [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey('Environment', $true)
    if ($null -eq $key) {
        $key = [Microsoft.Win32.Registry]::CurrentUser.CreateSubKey('Environment')
    }
    try {
        $current = $key.GetValue('Path', '', [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames)
        $kind = if ($null -eq $key.GetValue('Path')) { [Microsoft.Win32.RegistryValueKind]::ExpandString } else { $key.GetValueKind('Path') }
        if ($null -eq $current) { $current = '' }
        $entries = @([string]$current -split ';' | Where-Object { $_ })
        $normalized = $directory.TrimEnd('\')
        foreach ($entry in $entries) {
            if ([Environment]::ExpandEnvironmentVariables($entry).TrimEnd('\') -ieq $normalized) {
                Write-Host "$directory is already on your user PATH."
                return
            }
        }
        $updated = (@($entries) + $directory) -join ';'
        $key.SetValue('Path', $updated, $kind)
        Write-Host "Added $directory to your user PATH."
    } finally {
        $key.Close()
    }
}

$architecture = Get-Architecture
@PREREQUISITE_STEP@
$work = Join-Path ([System.IO.Path]::GetTempPath()) ("zai-install-" + [guid]::NewGuid().ToString('N'))
New-Item -ItemType Directory -Path $work -Force | Out-Null

try {
    $manifestFile = Join-Path $work 'manifest.json'
    Save-Download $manifestUrl $manifestFile
    try {
        $manifest = Get-Content -Path $manifestFile -Raw -Encoding UTF8 | ConvertFrom-Json
    } catch {
        Stop-Install "the release manifest at $manifestUrl could not be read as JSON."
    }

    if ($null -eq $manifest.release) {
        [Console]::Error.WriteLine("No public release of $displayName has been published yet.")
        [Console]::Error.WriteLine("Watch $site/apps/app/?id=$appId for the first build.")
        exit 2
    }

    $assets = @($manifest.release.assets |
        Where-Object {
            $_.platform -eq 'windows' -and
            $_.architecture -eq $architecture -and
            ([string] $_.file) -match '\.zip$'
        })
    if ($assets.Count -eq 0) {
        Stop-Install "the published release has no package for windows/$architecture. See $site/apps/releases/?id=$appId for the packages that are available."
    }
    if ($assets.Count -gt 1) {
        Stop-Install "the release manifest contains multiple ZIP packages for windows/$architecture. Refusing to choose one ambiguously."
    }
    $asset = $assets[0]
    if ($asset.file -match '[\\/]' -or $asset.file -match '\.\.') {
        Stop-Install "the manifest package name is not a plain filename: $($asset.file)"
    }

    $assetUrl = Get-Member -InputObject $asset -Name 'url' -MemberType NoteProperty |
        ForEach-Object { $asset.url }
    if ([string]::IsNullOrWhiteSpace($assetUrl)) {
        $assetUrl = ($manifestUrl -replace '/[^/]*$', '') + '/' + $asset.file
    }

    $archive = Join-Path $work $asset.file
    Write-Host "Downloading $displayName for windows/$architecture..."
    Save-Download $assetUrl $archive

    $actualHash = (Get-FileHash -Path $archive -Algorithm SHA256).Hash.ToLowerInvariant()
    $expectedHash = ([string] $asset.sha256).ToLowerInvariant()
    if ($actualHash -ne $expectedHash) {
        Stop-Install "SHA-256 verification failed for $($asset.file).`n  expected: $expectedHash`n  actual:   $actualHash`nThe download was discarded and nothing was installed."
    }
    $actualBytes = (Get-Item -Path $archive).Length
    $expectedBytes = Get-Member -InputObject $asset -Name 'bytes' -MemberType NoteProperty |
        ForEach-Object { $asset.bytes }
    if ($expectedBytes -and $actualBytes -ne $expectedBytes) {
        Stop-Install "the downloaded package is $actualBytes bytes but the manifest declares $expectedBytes. Nothing was installed."
    }
    Write-Host "Verified SHA-256 $expectedHash"

    $extract = Join-Path $work 'extract'
    New-Item -ItemType Directory -Path $extract -Force | Out-Null
    try {
        Expand-Archive -Path $archive -DestinationPath $extract -Force
    } catch {
        Stop-Install "the downloaded archive could not be extracted: $($_.Exception.Message)"
    }

@INSTALL_STEP@
} finally {
    Remove-Item -Path $work -Recurse -Force -ErrorAction SilentlyContinue
}
